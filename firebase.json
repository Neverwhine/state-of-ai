{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebase",
      ".git",
      "**/.git/**",
      ".gitignore",
      "sec3_snippet.html",
      "index.html.bak",
      "sec8-new.html",
      "sec13-new.html",
      "sec9-bridge-fix.txt",
      "fix-agent-anatomy.py",
      "qa/**",
      "qa-full/**",
      "**/*.bak",
      "**/.DS_Store"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      }
    ]
  }
}
